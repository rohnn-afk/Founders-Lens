{
  "name": "founders-lens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.22.3",
    "npm": "11.19.1"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/worker",
    "apps/dispatcher"
  ],
  "scripts": {
    "check-toolchain": "node scripts/check-toolchain.mjs",
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=@founders-lens/web",
    "dev:api": "npm run dev --workspace=@founders-lens/api",
    "dev:worker": "npm run dev --workspace=@founders-lens/worker",
    "dev:dispatcher": "npm run dev --workspace=@founders-lens/dispatcher",
    "build": "npm run check-toolchain && npm run build --workspaces",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:smoke": "node --test tests/shell-smoke.test.mjs",
    "test:boundaries": "node --test tests/import-boundaries.test.mjs",
    "test:infrastructure": "node tests/local-infrastructure.test.mjs --live"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
