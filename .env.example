# Local shell configuration only; no production dependencies.
# Set $env:API_PORT in PowerShell to override the API's default port.
API_PORT=3001
# Web uses port 3000 by default; both HTTP apps bind to 127.0.0.1.
# Readiness remains 503 until a separately authorized dependency/safety setup.

# Infrastructure: put these keys in the ignored .env.infrastructure file.
# Supply independent random passwords (64 lowercase hex characters each).
# Blank passwords intentionally fail Compose validation. Never commit real values.
POSTGRES_USER=founders_lens_local
POSTGRES_DB=founders_lens_local
POSTGRES_PASSWORD=
REDIS_PASSWORD=
POSTGRES_PORT=55432
REDIS_PORT=56379
