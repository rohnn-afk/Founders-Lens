# Local shell configuration only; no production dependencies.
# Set $env:API_PORT in PowerShell to override the API's default port.
API_PORT=3001
# Web uses port 3000 by default; both HTTP apps bind to 127.0.0.1.
# Readiness remains 503 until a separately authorized dependency/safety setup.

# Infrastructure: put these keys in the ignored .env.infrastructure file.
# Supply independent random passwords (64 lowercase hex characters each).
# Blank passwords intentionally fail Compose validation. Never commit real values.
POSTGRES_USER=founders_lens_local
POSTGRES_DB=founders_lens_local
POSTGRES_PASSWORD=
REDIS_PASSWORD=
POSTGRES_PORT=55432
REDIS_PORT=56379

# M02 database tool reads an ignored .env.database, not this file.
# Separate local migrator/runtime identities; never put bootstrap credentials here.
# Only 127.0.0.1:55432 and explicitly named founders_lens_m02_* targets are allowed.
MIGRATION_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=
SHADOW_DATABASE_URL=
DATABASE_URL=
TEST_DATABASE_URL=

# Security foundation is dormant: no private routes or runtime provisioning.
# Configure only after owner approval; real values belong in ignored local env.
CLERK_INSTANCE_ID=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=
CLERK_AUDIENCE=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
# Identity HMAC versions are supplied through the SubjectKeys boundary, never DB backups.
# Suppression runtime authority remains UNAVAILABLE; no positive-clearance env switch.
